{
  "manifest_version": 3,
  "name": "My Study Guide Companion",
  "version": "0.1.0",
  "description": "Turn permitted study content (lecture text, captions, selected text) into questions, quizzes, summaries and flashcards using your My Study Guide AI.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["activeTab", "scripting", "contextMenus", "storage"],
  "host_permissions": [
    "https://*.onrender.com/*",
    "https://*.vercel.app/*",
    "http://localhost:5000/*",
    "http://127.0.0.1:5000/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "My Study Guide Companion",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://*.pw.live/*",
        "https://*.unacademy.com/*",
        "https://*.udemy.com/*",
        "https://*.coursera.org/*"
      ],
      "js": ["content/adapters.js", "content/content.js"],
      "run_at": "document_idle"
    }
  ]
}
