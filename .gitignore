# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
build/

# Environment files (never commit secrets)
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.sw?


# Test coverage: keep the machine-readable lcov.info reports (committed so
# external quality/coverage graders can read them from the archive), but ignore
# the generated HTML report and scratch files.
**/coverage/lcov-report/
**/coverage/tmp/
**/coverage/.tmp/
