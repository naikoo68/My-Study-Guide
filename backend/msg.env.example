# Backend env for a self-managed host (e.g. an Oracle Cloud Always Free VM).
# Copy to `msg.env`, fill in the blanks, then run:
#   docker run -d --name msg-backend --restart always \
#     --env-file msg.env -p 127.0.0.1:5000:5000 msg-backend
# (See backend/HOSTING.md for the full VM + Nginx + HTTPS steps.)
# NOTE: never commit the filled-in msg.env — it holds secrets.

# ---- Server ----
NODE_ENV=production
PORT=5000
# Your frontend origin (for CORS), e.g. https://www.mystudyguide.in
CLIENT_URL=https://www.mystudyguide.in

# ---- Multi-tenancy ----
# MUST stay "on" in production: cross-institute (tenant) data isolation is only
# auto-enforced when this is on. A guard test (backend/tests/tenantEnforcement.test.js)
# fails the build if it is removed or flipped off here.
TENANT_ENFORCEMENT=on

# ---- Database engine: mongo | oracle | dynamo ----
DB_ENGINE=oracle

# Oracle Autonomous DB (MongoDB API) — when DB_ENGINE=oracle:
ORACLE_MONGO_URI=
ORACLE_MAX_POOL=20

# MongoDB — when DB_ENGINE=mongo:
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/mystudyguide

# DynamoDB — when DB_ENGINE=dynamo:
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# DYNAMODB_TABLE_PREFIX=msg_

# ---- Auth ----
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# ---- Admin bootstrap ----
ADMIN_EMAIL=admin@mystudyguide.com

# ---- Uploads (Cloudinary) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Email (optional; SMTP) ----
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# ---- Payments (optional; Razorpay) ----
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
