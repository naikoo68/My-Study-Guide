# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ---- Multi-tenant subdomains ------------------------------------------------
# The platform's root domain. When set, an institute is resolved from its
# subdomain (e.g. "my-abc-academy" from my-abc-academy.mystudyguide.in) and each
# institute automatically gets its own <slug>.<ROOT_DOMAIN> public site + /admin.
# Also surfaced to the frontend (GET /api/settings -> rootDomain) so registration
# and the institute cards show clean subdomain URLs instead of ?t=slug links.
# Leave blank in local dev. Set it in production once wildcard DNS is live.
# ROOT_DOMAIN=mystudyguide.in

# ---- Database engine switch -------------------------------------------------
# Choose which database the app uses. Change this one value + the matching
# settings below, then restart/redeploy — no code changes needed.
#   mongo  -> MongoDB (Mongoose)   [default]
#   dynamo -> AWS DynamoDB
#   oracle -> Oracle Autonomous Database via its MongoDB-compatible API (uses Mongoose)
DB_ENGINE=mongo

# --- MongoDB (used when DB_ENGINE=mongo) ---
MONGO_URI=mongodb://127.0.0.1:27017/mystudyguide

# --- Oracle Autonomous Database (used when DB_ENGINE=oracle) ---
# Uses Oracle's "Database API for MongoDB", so the app runs on Mongoose exactly
# like DB_ENGINE=mongo. Paste the connection string Oracle generates for the
# MongoDB API (it already includes TLS + auth + retryWrites=false). Keep the pool
# small — Always Free Oracle caps simultaneous sessions (~30). Also ensure this
# server's outbound IP is allowlisted in the Oracle database's network ACL.
# ORACLE_MONGO_URI=mongodb://ADMIN:PASSWORD@your-adb-host.oraclecloud.com:27017/admin?authMechanism=PLAIN&authSource=$external&ssl=true&retryWrites=false&loadBalanced=true
# ORACLE_MAX_POOL=20
# One-time data import from your OLD MongoDB into Oracle (set these, deploy, then
# remove RUN_ORACLE_IMPORT once the logs say "import complete"). Resumable.
#   Requires DB_ENGINE=oracle + ORACLE_MONGO_URI (target) + a source Mongo URI.
# RUN_ORACLE_IMPORT=true
# SOURCE_MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/mystudyguide   # your OLD data (falls back to MONGO_URI)
# RESET_IMPORT=true    # optional: wipe the target's import progress + re-clear + re-import from scratch
# IMPORT_ONLY=settings,users,testseries   # optional: import ONLY these collections (comma-separated).
#   Use with RESET_IMPORT=true to RECOVER a few collections without re-copying the big ones (e.g. questions).
#   Only the listed collections are cleared + re-imported; everything else is left untouched.

# --- AWS DynamoDB (used when DB_ENGINE=dynamo) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
DYNAMODB_TABLE_PREFIX=msg_
# For local DynamoDB (offline dev), set an endpoint (throw-away creds are used):
# DYNAMODB_ENDPOINT=http://localhost:8000
# One-time data import from MongoDB into DynamoDB (set both, deploy, then remove):
# RUN_MONGO_MIGRATION=true   (requires DB_ENGINE=dynamo + MONGO_URI pointing at your old DB)

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Cloudinary (file/image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret


# Admin bootstrap (creates/recovers an admin account on startup).
# Use a STRONG password: >= 8 chars with letters AND numbers. If left blank or
# weak, a random one-time password is generated and printed to the server logs,
# and a password change is forced on first login (no known default is ever set).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_to_a_strong_password
# ADMIN_RESET=true   # set temporarily to reset an existing admin's password

# Encryption secret for AI provider keys at rest (AES-256-GCM). Set to encrypt
# stored AI keys; if unset, keys are stored unencrypted (with a startup warning).
AI_KEY_ENC_SECRET=CHANGE_ME_to_a_long_random_secret

# Per-deploy secret required (together with a logged-in super-admin) to POST
# /api/setup/reset — the ONLY way to wipe & reseed the database. Leave unset to
# disable database reset entirely (the old unauthenticated ?force= wipe is gone).
SETUP_RESET_SECRET=CHANGE_ME_to_a_long_random_secret

# Email notifications (contact form). Example uses Gmail SMTP with an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM=your_gmail_address@gmail.com
# Where contact-form notifications are sent (defaults to SMTP_USER if unset)
NOTIFY_EMAIL=your_notification_email@example.com


# AI Question Generator (optional) — powers the "Generate with AI" button in the admin panel.
# Works with any OpenAI-compatible provider (TokenLab, OpenAI, Groq, DeepSeek, ...).
# Leave AI_API_KEY unset to disable the feature.
AI_API_KEY=your_tokenlab_api_key
AI_BASE_URL=https://api.tokenlab.sh/v1
# One OR many model ids, comma-separated. The first is the default; the admin
# can pick any of them from a dropdown. Example:
# AI_MODEL=gpt-4o-mini, llama-3.3-70b, deepseek-chat
AI_MODEL=gpt-4o-mini

# Auto-research the web (optional) — powers the "Auto-research the web" toggle in
# the AI generator so CURRENT-AFFAIRS questions are built from up-to-date facts.
# Without a key it works for free using Wikipedia. Set a Tavily key
# (https://tavily.com) for broader, fresher web search across many sites.
# TAVILY_API_KEY=your_tavily_api_key
